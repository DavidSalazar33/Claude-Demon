# --- Database ---
# Local dev (default): SQLite file.
DATABASE_URL="file:./dev.db"
# Self-hosted production: point at your Postgres and switch the datasource
# provider in prisma/schema.prisma from "sqlite" to "postgresql".
# DATABASE_URL="postgresql://user:password@host:5432/money_tracker?schema=public"

# --- Account data provider ---
# "mock"      -> realistic generated data (default, no credentials needed)
# "simplefin" -> real accounts via SimpleFIN ($15/yr, recommended for personal use)
# "plaid"     -> real accounts via Plaid (business-oriented; see plaidProvider.ts)
FINANCIAL_PROVIDER="mock"

# --- SimpleFIN (only needed when FINANCIAL_PROVIDER=simplefin) ---
# 1. Sign up at https://bridge.simplefin.org and create a setup token.
# 2. Run: npm run simplefin:claim <setup-token>
# 3. Paste the printed access URL here.
# SIMPLEFIN_ACCESS_URL="https://user:password@bridge.simplefin.org/simplefin"

# --- Plaid (only needed when FINANCIAL_PROVIDER=plaid) ---
# PLAID_CLIENT_ID=""
# PLAID_SECRET=""
# PLAID_ENV="sandbox"   # sandbox | development | production
