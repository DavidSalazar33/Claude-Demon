# --- Database ---
# Local dev (default): SQLite file.
DATABASE_URL="file:./dev.db"
# Self-hosted production: point at your Postgres and switch the datasource
# provider in prisma/schema.prisma from "sqlite" to "postgresql".
# DATABASE_URL="postgresql://user:password@host:5432/money_tracker?schema=public"

# --- Account data provider ---
# "mock"  -> realistic generated data (default, no credentials needed)
# "plaid" -> real accounts via Plaid (fill in credentials below, see lib/providers/plaidProvider.ts)
FINANCIAL_PROVIDER="mock"

# --- Plaid (only needed when FINANCIAL_PROVIDER=plaid) ---
# PLAID_CLIENT_ID=""
# PLAID_SECRET=""
# PLAID_ENV="sandbox"   # sandbox | development | production
